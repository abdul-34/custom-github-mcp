# ── Required ─────────────────────────────────────────────────────────────────

# GitHub Personal Access Token the tools act with.
# https://github.com/settings/tokens?type=beta — scopes: repo, read:org, read:user, workflow
GITHUB_TOKEN=

# Shared secret your MCP client must present. NOT your GitHub PAT.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
 
# ── Recommended ──────────────────────────────────────────────────────────────

# Register only read tools. Write tools are not advertised and cannot be called.
MCP_READ_ONLY=false

# Restrict repo-scoped tools to these repos. Empty = every repo the PAT can see.
# Comma-separated, e.g. myorg/api,myorg/web
ALLOWED_REPOS=

# ── Optional ─────────────────────────────────────────────────────────────────

# Accept the token as ?key=<token> for clients that cannot set headers.
# Weaker — URLs land in logs, history, and referrers. Prefer the header.
MCP_ALLOW_QUERY_TOKEN=false

# Browser origins allowed to call this server. Empty = no cross-origin access.
ALLOWED_ORIGINS=

PORT=8080
# Bind address. Leave 0.0.0.0 for containers and PaaS. Set 127.0.0.1 on a VM
# where a local reverse proxy is the only intended caller.
HOST=0.0.0.0

RATE_LIMIT_PER_MINUTE=240
MAX_SESSIONS=50
SESSION_IDLE_MINUTES=30

# Proxy hops to trust for client IPs. 0 = trust nothing (correct when Node is
# exposed directly). 1 = behind Render / DO App Platform / Fly / your own nginx
# or Caddy. Getting this wrong silently disables rate limiting — see
# DEPLOYMENT.md.
TRUST_PROXY=0
